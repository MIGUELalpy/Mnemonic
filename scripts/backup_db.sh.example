# Weekly PostgreSQL backup synced to a remote machine.
#
# Setup:
#   1. Copy this file: cp scripts/backup_db.sh.example scripts/backup_db.sh
#   2. Fill in the variables below
#   3. Set up SSH key auth: ssh-copy-id USER@REMOTE_IP
#   4. Test: bash scripts/backup_db.sh
#   5. Add to cron: 0 3 * * 0 bash /full/path/to/scripts/backup_db.sh

set -e

MNEMONIC_DIR="/home/YOUR_USER/path/to/mnemonic"
BACKUP_DIR="$MNEMONIC_DIR/data/backups"
REMOTE="YOUR_USER@YOUR_REMOTE_IP:/path/on/remote/mnemonic/backups/"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)

mkdir -p "$BACKUP_DIR"

docker compose -f "$MNEMONIC_DIR/docker-compose.yml" exec -T postgres \
  pg_dump -U mnemonic mnemonic > "$BACKUP_DIR/mnemonic_$TIMESTAMP.sql"

echo "Backup saved: $BACKUP_DIR/mnemonic_$TIMESTAMP.sql"

ssh YOUR_USER@YOUR_REMOTE_IP "mkdir -p /path/on/remote/mnemonic/backups/" 2>/dev/null || true
rsync -avz "$BACKUP_DIR/mnemonic_$TIMESTAMP.sql" "$REMOTE"
echo "Synced to remote."

ls -t "$BACKUP_DIR"/*.sql | tail -n +11 | xargs rm -f 2>/dev/null || true