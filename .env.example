# Mnemonic — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Generate a secure API token with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# Authentication
# Token used for all API calls and the web UI
MNEMONIC_API_TOKEN=generate_a_random_token_here

#PostgreSQL
POSTGRES_USER=mnemonic
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=mnemonic

#Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_strong_password

#  User profile 
MNEMONIC_USER_NAME=Developer
MNEMONIC_USER_LANG=EN

# Secondary node (optional) 
# BGE-M3 embeddings + DeBERTa NLI run on a separate GPU machine
# Set to your secondary machine's IP after running ./start.sh there
SECONDARY_NODE_URL=http://192.168.1.X:8001
SECONDARY_NODE_TIMEOUT=120.0

#  Ollama (local LLM) 
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

#  Piston (code execution) 
PISTON_URL=http://piston:2000

#  Application 
ENVIRONMENT=production
LOG_LEVEL=INFO

#  Retrieval settings 
# Increase for more diverse citations (uses more VRAM during inference)
RETRIEVAL_TOP_K_REALTIME=12
RETRIEVAL_TOP_K_ASYNC=12
RETRIEVAL_MAX_CHUNKS_PER_SOURCE=2
PROMPT_TOKEN_WARN_THRESHOLD=2500
